<Window x:Class="RB_TypeName.UI.RbrObjectIdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RBR Object ID — Type Name"
        Width="1080" Height="760"
        MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Row 0: PBS File (shared) -->
            <RowDefinition Height="*"    />  <!-- Row 1: TabControl -->
        </Grid.RowDefinitions>

        <!-- ── PBS File (shared across both tabs) ───────────────────────── -->
        <GroupBox Grid.Row="0" Header="PBS File" Margin="0,0,0,8">
            <Grid Margin="8,6,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PbsFilePathBox"
                         Grid.Column="0"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Margin="0,0,4,0"
                         Height="26" />
                <Button x:Name="BrowseButton"
                        Grid.Column="1"
                        Content="Browse…"
                        Width="75" Height="26"
                        Margin="0,0,4,0"
                        Click="Browse_Click" />
                <Button x:Name="ReloadButton"
                        Grid.Column="2"
                        Content="Reload"
                        Width="62" Height="26"
                        Click="Reload_Click" />
            </Grid>
        </GroupBox>

        <!-- ── Tab Control ──────────────────────────────────────────────── -->
        <TabControl Grid.Row="1">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--  TAB 1: Object IDs                                        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <TabItem Header="Object IDs">
                <Grid Margin="4,8,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />  <!-- Row 0: Options -->
                        <RowDefinition Height="Auto" />  <!-- Row 1: PBS Mapping -->
                        <RowDefinition Height="Auto" />  <!-- Row 2: Warnings -->
                        <RowDefinition Height="Auto" />  <!-- Row 3: Action buttons -->
                        <RowDefinition Height="*"    />  <!-- Row 4: Results grid -->
                        <RowDefinition Height="Auto" />  <!-- Row 5: Summary footer -->
                    </Grid.RowDefinitions>

                    <!-- ── Options ──────────────────────────────────────── -->
                    <GroupBox Grid.Row="0" Header="Options" Margin="0,0,0,8">
                        <StackPanel Orientation="Vertical" Margin="8,6,8,6">
                            <CheckBox x:Name="UseRbrPrCodeLookupCheck"
                                      Content="Use RBR_Pr_Code lookup as primary source  (Preview → Apply workflow)"
                                      IsChecked="True"
                                      Margin="0,0,0,4"
                                      Checked="OptionCheckBox_Changed"
                                      Unchecked="OptionCheckBox_Changed" />
                            <CheckBox x:Name="UseManualMappingFallbackCheck"
                                      Content="Allow manual mapping fallback when RBR_Pr_Code lookup fails"
                                      IsChecked="False"
                                      Checked="OptionCheckBox_Changed"
                                      Unchecked="OptionCheckBox_Changed" />
                        </StackPanel>
                    </GroupBox>

                    <!-- ── PBS Mapping (manual fallback) ────────────────── -->
                    <GroupBox Grid.Row="1" Header="PBS Mapping  (R – S columns)  —  manual fallback" Margin="0,0,0,8">
                        <Grid Margin="8,6,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="MappingCombo"
                                      Grid.Column="0"
                                      DisplayMemberPath="DisplayName"
                                      Height="26"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="MappingCombo_SelectionChanged" />
                            <TextBlock x:Name="MappingStatusText"
                                       Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       FontStyle="Italic"
                                       FontSize="11" />
                        </Grid>
                    </GroupBox>

                    <!-- ── Warnings ─────────────────────────────────────── -->
                    <Border x:Name="WarningsBorder"
                            Grid.Row="2"
                            Background="#FFF3CD"
                            BorderBrush="#FFC107"
                            BorderThickness="1"
                            CornerRadius="3"
                            Margin="0,0,0,8"
                            Padding="8,5"
                            Visibility="Collapsed">
                        <TextBlock x:Name="WarningsText"
                                   Foreground="#856404"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- ── Action buttons ───────────────────────────────── -->
                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PreviewButton"
                                Grid.Column="1"
                                Content="Preview Object IDs"
                                Width="130" Height="32"
                                Margin="0,0,6,0"
                                FontSize="12"
                                Click="Preview_Click" />
                        <Button x:Name="ApplyButton"
                                Grid.Column="2"
                                Content="Apply Object IDs"
                                Width="120" Height="32"
                                Margin="0,0,6,0"
                                FontSize="12"
                                IsEnabled="False"
                                Click="Apply_Click" />
                        <Button x:Name="AssignButton"
                                Grid.Column="3"
                                Content="Assign (manual)"
                                Width="110" Height="32"
                                Margin="0,0,6,0"
                                FontSize="12"
                                Click="Assign_Click" />
                        <Button x:Name="ExportButton"
                                Grid.Column="4"
                                Content="Export Report"
                                Width="105" Height="32"
                                FontSize="12"
                                IsEnabled="False"
                                Click="Export_Click" />
                    </Grid>

                    <!-- ── Results DataGrid ──────────────────────────────── -->
                    <DataGrid x:Name="ResultsGrid"
                              Grid.Row="4"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="#CCCCCC"
                              BorderThickness="1"
                              FontSize="11"
                              PreviewMouseLeftButtonDown="ResultsGrid_PreviewMouseLeftButtonDown">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓"
                                                    Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="32" />
                            <DataGridTextColumn Header="Element ID"
                                                Binding="{Binding ElementIdValue}"
                                                IsReadOnly="True"
                                                Width="80" />
                            <DataGridTextColumn Header="Category"
                                                Binding="{Binding Category}"
                                                IsReadOnly="True"
                                                Width="110" />
                            <DataGridTextColumn Header="Level"
                                                Binding="{Binding LevelCode}"
                                                IsReadOnly="True"
                                                Width="55" />
                            <DataGridTextColumn Header="RBR_Pr_Code"
                                                Binding="{Binding RbrPrCode}"
                                                IsReadOnly="True"
                                                Width="100" />
                            <DataGridTextColumn Header="PBS R"
                                                Binding="{Binding PbsPartR}"
                                                IsReadOnly="True"
                                                Width="55" />
                            <DataGridTextColumn Header="PBS S"
                                                Binding="{Binding PbsPartS}"
                                                IsReadOnly="True"
                                                Width="55" />
                            <DataGridTextColumn Header="Existing Object ID"
                                                Binding="{Binding ExistingObjectId}"
                                                IsReadOnly="True"
                                                Width="145" />
                            <DataGridTextColumn Header="Proposed Object ID"
                                                Binding="{Binding ProposedObjectId}"
                                                IsReadOnly="True"
                                                Width="145" />
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                IsReadOnly="True"
                                                Width="175" />
                            <DataGridTextColumn Header="Message"
                                                Binding="{Binding Message}"
                                                IsReadOnly="True"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ── Summary footer ───────────────────────────────── -->
                    <TextBlock x:Name="SummaryText"
                               Grid.Row="5"
                               Margin="0,6,0,0"
                               FontWeight="SemiBold"
                               FontSize="12" />
                </Grid>
            </TabItem>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--  TAB 2: Type Numbers                                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <TabItem Header="Type Numbers">
                <Grid Margin="4,8,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />  <!-- Row 0: Toolbar -->
                        <RowDefinition Height="Auto" />  <!-- Row 1: Warnings -->
                        <RowDefinition Height="*"    />  <!-- Row 2: DataGrid -->
                        <RowDefinition Height="Auto" />  <!-- Row 3: Summary footer -->
                    </Grid.RowDefinitions>

                    <!-- ── Type Numbers Toolbar ──────────────────────────── -->
                    <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,8">

                        <!-- Filter row: Discipline + Type Source -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Discipline:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <ComboBox x:Name="DisciplineCombo"
                                      Width="140" Height="26"
                                      VerticalContentAlignment="Center"
                                      Margin="0,0,14,0"
                                      SelectionChanged="DisciplineCombo_SelectionChanged" />

                            <TextBlock Text="Type source:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <ComboBox x:Name="TypeSourceCombo"
                                      Width="210" Height="26"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="TypeSourceCombo_SelectionChanged" />
                        </StackPanel>

                        <!-- Button row -->
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LoadTypesButton"
                                    Content="Load All Types"
                                    Width="170" Height="26"
                                    Margin="0,0,6,0"
                                    FontSize="12"
                                    Click="LoadTypes_Click" />
                            <Button x:Name="SaveMappingsButton"
                                    Content="Save Mappings"
                                    Width="115" Height="26"
                                    Margin="0,0,6,0"
                                    FontSize="12"
                                    IsEnabled="False"
                                    Click="SaveMappings_Click" />
                            <Button x:Name="ExportMappingButton"
                                    Content="Export Mapping…"
                                    Width="125" Height="26"
                                    Margin="0,0,6,0"
                                    FontSize="12"
                                    IsEnabled="False"
                                    Click="ExportMapping_Click" />
                            <Button x:Name="ImportMappingButton"
                                    Content="Import Mapping…"
                                    Width="125" Height="26"
                                    Margin="0,0,6,0"
                                    FontSize="12"
                                    Click="ImportMapping_Click" />
                            <Button x:Name="PreviewTypeNumbersButton"
                                    Content="Preview Type Numbers"
                                    Width="155" Height="26"
                                    Margin="0,0,6,0"
                                    FontSize="12"
                                    IsEnabled="False"
                                    Click="PreviewTypeNumbers_Click" />
                            <Button x:Name="ApplyTypeNumbersButton"
                                    Content="Apply Type Numbers"
                                    Width="140" Height="26"
                                    Margin="0,0,6,0"
                                    FontSize="12"
                                    IsEnabled="False"
                                    Click="ApplyTypeNumbers_Click" />
                            <Button x:Name="ExportTypeNumbersButton"
                                    Content="Export Report"
                                    Width="105" Height="26"
                                    Margin="0,0,6,0"
                                    FontSize="12"
                                    IsEnabled="False"
                                    Click="ExportTypeNumbers_Click" />
                            <TextBlock x:Name="TypeNumberStatusText"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Foreground="Gray"
                                       FontStyle="Italic"
                                       FontSize="11" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ── Type Numbers Warnings ─────────────────────────── -->
                    <Border x:Name="TypeNumberWarningsBorder"
                            Grid.Row="1"
                            Background="#FFF3CD"
                            BorderBrush="#FFC107"
                            BorderThickness="1"
                            CornerRadius="3"
                            Margin="0,0,0,8"
                            Padding="8,5"
                            Visibility="Collapsed">
                        <TextBlock x:Name="TypeNumberWarningsText"
                                   Foreground="#856404"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- ── Type Numbers DataGrid ─────────────────────────── -->
                    <DataGrid x:Name="TypeNumbersGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="#CCCCCC"
                              BorderThickness="1"
                              FontSize="11"
                              PreviewMouseLeftButtonDown="TypeNumbersGrid_PreviewMouseLeftButtonDown">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓"
                                                    Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="32" />
                            <DataGridTextColumn Header="Category"
                                                Binding="{Binding Category}"
                                                IsReadOnly="True"
                                                Width="110" />
                            <DataGridTextColumn Header="Family Name"
                                                Binding="{Binding FamilyName}"
                                                IsReadOnly="True"
                                                Width="130" />
                            <DataGridTextColumn Header="Type Name"
                                                Binding="{Binding TypeName}"
                                                IsReadOnly="True"
                                                Width="150" />
                            <DataGridTextColumn Header="Type Source Value"
                                                Binding="{Binding TypeSourceValue}"
                                                IsReadOnly="True"
                                                Width="140" />
                            <DataGridTextColumn Header="Instances"
                                                Binding="{Binding InstanceCount}"
                                                IsReadOnly="True"
                                                Width="65" />
                            <DataGridTextColumn Header="RBR_Pr_Code"
                                                Binding="{Binding RbrPrCode}"
                                                IsReadOnly="True"
                                                Width="100" />
                            <DataGridTextColumn Header="PBS Match"
                                                Binding="{Binding PbsMatchStatus}"
                                                IsReadOnly="True"
                                                Width="120" />
                            <DataGridTextColumn Header="PBS Template"
                                                Binding="{Binding PbsTypeTemplate}"
                                                IsReadOnly="True"
                                                Width="110" />
                            <DataGridTextColumn Header="L1 Code"
                                                Binding="{Binding L1Code, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                Width="90" />
                            <DataGridTextColumn Header="Mapping"
                                                Binding="{Binding MappingStatus}"
                                                IsReadOnly="True"
                                                Width="100" />
                            <DataGridTextColumn Header="Existing Type#"
                                                Binding="{Binding ExistingTypeNumber}"
                                                IsReadOnly="True"
                                                Width="140" />
                            <DataGridTextColumn Header="Proposed Type#"
                                                Binding="{Binding ProposedTypeNumber}"
                                                IsReadOnly="True"
                                                Width="140" />
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                IsReadOnly="True"
                                                Width="175" />
                            <DataGridTextColumn Header="Message"
                                                Binding="{Binding Message}"
                                                IsReadOnly="True"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ── Type Numbers Summary footer ───────────────────── -->
                    <TextBlock x:Name="TypeNumberSummaryText"
                               Grid.Row="3"
                               Margin="0,6,0,0"
                               FontWeight="SemiBold"
                               FontSize="12" />
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
