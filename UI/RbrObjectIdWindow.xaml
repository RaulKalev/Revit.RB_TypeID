<Window x:Class="RB_TypeName.UI.RbrObjectIdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RBR Object ID — Type Name"
        Width="900" Height="720"
        MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Row 0: PBS File -->
            <RowDefinition Height="Auto" />  <!-- Row 1: Options -->
            <RowDefinition Height="Auto" />  <!-- Row 2: PBS Mapping (manual fallback) -->
            <RowDefinition Height="Auto" />  <!-- Row 3: Warnings -->
            <RowDefinition Height="Auto" />  <!-- Row 4: Action buttons -->
            <RowDefinition Height="*"    />  <!-- Row 5: Results grid -->
            <RowDefinition Height="Auto" />  <!-- Row 6: Summary footer -->
        </Grid.RowDefinitions>

        <!-- ── PBS File ─────────────────────────────────────────────────── -->
        <GroupBox Grid.Row="0" Header="PBS File" Margin="0,0,0,8">
            <Grid Margin="8,6,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PbsFilePathBox"
                         Grid.Column="0"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Margin="0,0,4,0"
                         Height="26" />
                <Button x:Name="BrowseButton"
                        Grid.Column="1"
                        Content="Browse…"
                        Width="75" Height="26"
                        Margin="0,0,4,0"
                        Click="Browse_Click" />
                <Button x:Name="ReloadButton"
                        Grid.Column="2"
                        Content="Reload"
                        Width="62" Height="26"
                        Click="Reload_Click" />
            </Grid>
        </GroupBox>

        <!-- ── Options ──────────────────────────────────────────────────── -->
        <GroupBox Grid.Row="1" Header="Options" Margin="0,0,0,8">
            <StackPanel Orientation="Vertical" Margin="8,6,8,6">
                <CheckBox x:Name="UseRbrPrCodeLookupCheck"
                          Content="Use RBR_Pr_Code lookup as primary source  (Preview → Apply workflow)"
                          IsChecked="True"
                          Margin="0,0,0,4"
                          Checked="OptionCheckBox_Changed"
                          Unchecked="OptionCheckBox_Changed" />
                <CheckBox x:Name="UseManualMappingFallbackCheck"
                          Content="Allow manual mapping fallback when RBR_Pr_Code lookup fails"
                          IsChecked="False"
                          Checked="OptionCheckBox_Changed"
                          Unchecked="OptionCheckBox_Changed" />
            </StackPanel>
        </GroupBox>

        <!-- ── PBS Mapping (manual fallback) ────────────────────────────── -->
        <GroupBox Grid.Row="2" Header="PBS Mapping  (R – S columns)  —  manual fallback" Margin="0,0,0,8">
            <Grid Margin="8,6,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="MappingCombo"
                          Grid.Column="0"
                          DisplayMemberPath="DisplayName"
                          Height="26"
                          VerticalContentAlignment="Center"
                          SelectionChanged="MappingCombo_SelectionChanged" />
                <TextBlock x:Name="MappingStatusText"
                           Grid.Column="1"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="Gray"
                           FontStyle="Italic"
                           FontSize="11" />
            </Grid>
        </GroupBox>

        <!-- ── Warnings (duplicates / malformed IDs / apply errors) ─────── -->
        <Border x:Name="WarningsBorder"
                Grid.Row="3"
                Background="#FFF3CD"
                BorderBrush="#FFC107"
                BorderThickness="1"
                CornerRadius="3"
                Margin="0,0,0,8"
                Padding="8,5"
                Visibility="Collapsed">
            <TextBlock x:Name="WarningsText"
                       Foreground="#856404"
                       FontSize="11"
                       TextWrapping="Wrap" />
        </Border>

        <!-- ── Action buttons ───────────────────────────────────────────── -->
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PreviewButton"
                    Grid.Column="1"
                    Content="Preview Object IDs"
                    Width="130" Height="32"
                    Margin="0,0,6,0"
                    FontSize="12"
                    Click="Preview_Click" />
            <Button x:Name="ApplyButton"
                    Grid.Column="2"
                    Content="Apply Object IDs"
                    Width="120" Height="32"
                    Margin="0,0,6,0"
                    FontSize="12"
                    IsEnabled="False"
                    Click="Apply_Click" />
            <Button x:Name="AssignButton"
                    Grid.Column="3"
                    Content="Assign (manual)"
                    Width="110" Height="32"
                    Margin="0,0,6,0"
                    FontSize="12"
                    Click="Assign_Click" />
            <Button x:Name="ExportButton"
                    Grid.Column="4"
                    Content="Export Report"
                    Width="105" Height="32"
                    FontSize="12"
                    IsEnabled="False"
                    Click="Export_Click" />
        </Grid>

        <!-- ── Results DataGrid ─────────────────────────────────────────── -->
        <DataGrid x:Name="ResultsGrid"
                  Grid.Row="5"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="#CCCCCC"
                  BorderThickness="1"
                  FontSize="11"
                  PreviewMouseLeftButtonDown="ResultsGrid_PreviewMouseLeftButtonDown">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="✓"
                                        Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="32" />
                <DataGridTextColumn Header="Element ID"
                                    Binding="{Binding ElementIdValue}"
                                    IsReadOnly="True"
                                    Width="80" />
                <DataGridTextColumn Header="Category"
                                    Binding="{Binding Category}"
                                    IsReadOnly="True"
                                    Width="110" />
                <DataGridTextColumn Header="Level"
                                    Binding="{Binding LevelCode}"
                                    IsReadOnly="True"
                                    Width="55" />
                <DataGridTextColumn Header="RBR_Pr_Code"
                                    Binding="{Binding RbrPrCode}"
                                    IsReadOnly="True"
                                    Width="100" />
                <DataGridTextColumn Header="PBS R"
                                    Binding="{Binding PbsPartR}"
                                    IsReadOnly="True"
                                    Width="55" />
                <DataGridTextColumn Header="PBS S"
                                    Binding="{Binding PbsPartS}"
                                    IsReadOnly="True"
                                    Width="55" />
                <DataGridTextColumn Header="Existing Object ID"
                                    Binding="{Binding ExistingObjectId}"
                                    IsReadOnly="True"
                                    Width="145" />
                <DataGridTextColumn Header="Proposed Object ID"
                                    Binding="{Binding ProposedObjectId}"
                                    IsReadOnly="True"
                                    Width="145" />
                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    IsReadOnly="True"
                                    Width="175" />
                <DataGridTextColumn Header="Message"
                                    Binding="{Binding Message}"
                                    IsReadOnly="True"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── Summary footer ───────────────────────────────────────────── -->
        <TextBlock x:Name="SummaryText"
                   Grid.Row="6"
                   Margin="0,6,0,0"
                   FontWeight="SemiBold"
                   FontSize="12" />
    </Grid>
</Window>
